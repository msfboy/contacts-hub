# === ContactsHub SaaS — Variables d'environnement Railway ===
# Copiez ces variables dans Railway > Service > Variables

# Mode SaaS & HTTPS (active ProxyFix, cookies Secure, désactive l'explorateur disque local)
CONTACTSHUB_SAAS_MODE=1
CONTACTSHUB_HTTPS=1

# Répertoire du Volume persistant monté dans Railway (OBLIGATOIRE pour garder contacts.db + WhatsApp)
CONTACTSHUB_DATA_DIR=/data

# Clés cryptographiques (générez 2 chaînes aléatoires hex de 64 caractères)
# Commande : python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=remplacer_par_64_caracteres_hex_aleatoires
CONTACTSHUB_MASTER_KEY=remplacer_par_64_caracteres_hex_aleatoires
WA_BRIDGE_SECRET=remplacer_par_64_caracteres_hex_aleatoires

# Compte Administrateur initial (crée le compte et active l'auth automatiquement au 1er démarrage)
CONTACTSHUB_ADMIN_USER=admin
CONTACTSHUB_ADMIN_PASSWORD=ChoisirUnMotDePasseFort123!

# Optionnel : App Secret Meta pour vérifier X-Hub-Signature-256 sur /webhooks/facebook
# FB_APP_SECRET=
